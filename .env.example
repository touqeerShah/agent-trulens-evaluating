# Copy this file to .env and fill in values only if you run the legacy
# Snowflake/Cortex examples in src/helper.py.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PAT=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=

# Local Ollama configuration for the new practice examples.
OLLAMA_MODEL=gemma4:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0

# Google Programmable Search JSON API
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_SEARCH_RESULTS=5
